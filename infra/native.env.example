# 复制到项目根目录 .env.native；此文件不会自动执行任何命令。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=interviewcopilot
MYSQL_USER=interviewcopilot
MYSQL_PASSWORD=
INTERNAL_AI_SERVICE_TOKEN=
JWT_SIGNING_SECRET=
AI_PROVIDER=mock
AI_SERVICE_PORT=8001
BUSINESS_SERVICE_PORT=8080
FRONTEND_PORT=5173

# 已有隔离 MariaDB 的配置文件。修改为你自己的路径。
MARIADB_CONFIG=E:\InterviewCopilotLocal\mysql-data\my.ini
# 留空时自动查找本机已安装的隔离 MariaDB。
MARIADB_EXECUTABLE=
