# Local host ports. Internal container ports stay fixed.
BUSINESS_SERVICE_PORT=8080
FRONTEND_PORT=5173

# Local MySQL configuration. Both passwords are required and intentionally blank.
MYSQL_DATABASE=interviewcopilot
MYSQL_USER=interviewcopilot
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Internal Java-to-Python authentication. The token is required and intentionally blank.
INTERNAL_AI_SERVICE_TOKEN=
AI_PROVIDER=mock

# User access JWT signing key. Use at least 32 visible ASCII characters.
JWT_SIGNING_SECRET=

# Java-to-Python client timeouts.
AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=5s
